{
  "name": "hawkeye-engagement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --var LOCAL_DEV:true",
    "build": "vite build",
    "preview": "vite preview",
    "dev:ui": "vite",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "papaparse": "^5.5.3",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "wrangler": "^4.0.0"
  }
}
